---
import BaseLayout from '../layouts/BaseLayout.astro';
const basePath = '/investiq-zero-debt-india/';
---

<BaseLayout
  title="Page Not Found (404) | InvestiQ ZeroDebt India"
  description="The requested page or statutory guide could not be located on ZeroDebt India."
  showSidebars={false}
>
  <div style="text-align: center; padding: 4rem 1.5rem; max-width: 600px; margin: 0 auto;">
    <span style="font-size: 3.5rem; font-weight: 800; color: var(--accent-rose); display: block; margin-bottom: 0.5rem;">404</span>
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 1rem;">Page Not Found</h1>
    <p style="font-size: 1rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 2rem;">
      The requested statutory analysis, calculator, or guide may have moved or does not exist. Use the links below to return to active resources:
    </p>

    <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <a href={basePath} class="btn btn-primary">Return to Home</a>
      <a href={`${basePath}articles/`} class="btn btn-secondary">Explore Guides Library</a>
      <a href={`${basePath}tools/`} class="btn btn-secondary">Financial Tools</a>
    </div>
  </div>
</BaseLayout>
