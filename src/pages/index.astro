---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const basePath = '/investiq-zero-debt-india/';
---

<BaseLayout
  title="ZeroDebt India — Debt Avalanche, Recovery Rights & Credit Repair"
  description="Autonomous public research and computational engine for Indian borrowers. Scientifically triage multi-loan debt, simulate revolving 42% credit card APR compounding, and enforce RBI statutory recovery rights."
  showSidebars={true}
>
  <!-- Hero Section -->
  <div style="background: linear-gradient(135deg, rgba(16,185,129,0.12) 0%, rgba(6,182,212,0.08) 100%); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 3rem 2rem; margin-bottom: 3rem; position: relative; overflow: hidden;">
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
      <span class="meta-tag">Site 03 of 60</span>
      <span class="meta-tag" style="background: var(--accent-emerald-subtle); color: var(--accent-emerald);">InvestiQ India Network</span>
      <span class="meta-tag" style="background: var(--bg-tertiary); color: var(--text-muted);">100% Client-Side Engine</span>
    </div>

    <h1 style="font-size: 2.75rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.03em; margin-bottom: 1rem; color: var(--text-primary); max-width: 900px;">
      Eliminate Indian Debt Mathematically.<br />
      <span style="color: var(--accent-emerald);">Enforce Your Legal Rights.</span>
    </h1>

    <p style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6; max-width: 820px; margin-bottom: 2rem;">
      ZeroDebt India is an autonomous, free-first research portal and quantitative calculation suite. Triage high-interest loans with the mathematical Debt Avalanche, deconstruct credit card 42% APR compounding traps, and enforce statutory protections under RBI Fair Practices Codes and the SARFAESI Act.
    </p>

    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <a href={`${basePath}tools/debt-payoff-calculator/`} class="btn btn-primary" style="padding: 0.85rem 1.5rem; font-size: 1rem;">
        Launch Multi-Loan Avalanche Tool →
      </a>
      <a href={`${basePath}tools/rbi-complaint-checker/`} class="btn btn-secondary" style="padding: 0.85rem 1.5rem; font-size: 1rem;">
        RBI Complaint & ₹100/Day Checker
      </a>
    </div>
  </div>

  <!-- Key Metrics / Network Highlights -->
  <div class="stats-grid" style="margin-bottom: 3.5rem;">
    <div class="stat-card">
      <div class="stat-label">Statutory Research</div>
      <div class="stat-value highlight">15 Deep Guides</div>
      <p style="font-size: 0.775rem; color: var(--text-muted); margin-top: 0.25rem;">Peer-reviewed statutory Indian analysis</p>
    </div>
    <div class="stat-card">
      <div class="stat-label">Interactive Utilities</div>
      <div class="stat-value">3 Client Tools</div>
      <p style="font-size: 0.775rem; color: var(--text-muted); margin-top: 0.25rem;">Multi-Loan, CC APR & RBI Drafter</p>
    </div>
    <div class="stat-card">
      <div class="stat-label">Privacy Guarantee</div>
      <div class="stat-value highlight">0 Trackers</div>
      <p style="font-size: 0.775rem; color: var(--text-muted); margin-top: 0.25rem;">Zero cookies, zero remote data logging</p>
    </div>
    <div class="stat-card">
      <div class="stat-label">Statutory Backing</div>
      <div class="stat-value">RBI & SARFAESI</div>
      <p style="font-size: 0.775rem; color: var(--text-muted); margin-top: 0.25rem;">Anchored to gazettes & primary laws</p>
    </div>
  </div>

  <!-- Core Interactive Tools Section -->
  <section style="margin-bottom: 4rem;">
    <div style="border-bottom: 2px solid var(--border-subtle); padding-bottom: 0.75rem; margin-bottom: 1.75rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h2 style="font-size: 1.65rem; font-weight: 800; color: var(--text-primary);">First-Class Interactive Browser Tools</h2>
        <p style="font-size: 0.95rem; color: var(--text-muted); margin-top: 0.25rem;">All calculations run 100% client-side in your browser. No sensitive financial data leaves your device.</p>
      </div>
      <a href={`${basePath}tools/`} style="font-size: 0.9rem; font-weight: 600; color: var(--accent-emerald);">Explore All Tools →</a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
      <!-- Tool 1 -->
      <div class="card-widget" style="padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span style="font-size: 0.75rem; background: var(--accent-emerald-subtle); color: var(--accent-emerald); font-weight: 700; padding: 0.2rem 0.5rem; border-radius: var(--radius-sm);">DEBT TRIAGE</span>
          <h3 style="font-size: 1.25rem; font-weight: 700; margin: 0.75rem 0 0.5rem 0;">Multi-Loan Avalanche & Snowball Simulator</h3>
          <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem;">
            Enter your active credit cards, personal loans, and auto loans. Compare the rupee interest savings and exact debt-free dates between highest APR first (Avalanche) and smallest balance first (Snowball).
          </p>
        </div>
        <a href={`${basePath}tools/debt-payoff-calculator/`} class="btn btn-secondary btn-sm" style="width: 100%;">Run Avalanche Simulator →</a>
      </div>

      <!-- Tool 2 -->
      <div class="card-widget" style="padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span style="font-size: 0.75rem; background: var(--accent-rose-subtle); color: var(--accent-rose); font-weight: 700; padding: 0.2rem 0.5rem; border-radius: var(--radius-sm);">COMPOUND INTEREST</span>
          <h3 style="font-size: 1.25rem; font-weight: 700; margin: 0.75rem 0 0.5rem 0;">Credit Card APR & MAD Payoff Calculator</h3>
          <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem;">
            Simulate 42% annualized APR compounding, daily interest accrual, loss of grace period, and the multi-decade trap of paying only the 5% Minimum Amount Due (MAD) with 18% statutory GST.
          </p>
        </div>
        <a href={`${basePath}tools/credit-card-interest-calculator/`} class="btn btn-secondary btn-sm" style="width: 100%;">Run Credit Card Tool →</a>
      </div>

      <!-- Tool 3 -->
      <div class="card-widget" style="padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span style="font-size: 0.75rem; background: var(--accent-cyan-subtle); color: var(--accent-cyan); font-weight: 700; padding: 0.2rem 0.5rem; border-radius: var(--radius-sm);">BORROWER RIGHTS</span>
          <h3 style="font-size: 1.25rem; font-weight: 700; margin: 0.75rem 0 0.5rem 0;">RBI Complaint Drafter & Delay Checker</h3>
          <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem;">
            Diagnose illegal recovery agent calling hours (outside 8 AM – 7 PM), calculate your statutory entitlement to ₹100/day compensation under RBI/2023-24/72, and generate a formal grievance notice.
          </p>
        </div>
        <a href={`${basePath}tools/rbi-complaint-checker/`} class="btn btn-secondary btn-sm" style="width: 100%;">Draft RBI Representation →</a>
      </div>
    </div>
  </section>

  <!-- Featured Research Articles Section -->
  <section style="margin-bottom: 4rem;">
    <div style="border-bottom: 2px solid var(--border-subtle); padding-bottom: 0.75rem; margin-bottom: 1.75rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h2 style="font-size: 1.65rem; font-weight: 800; color: var(--text-primary);">Peer-Reviewed Guides & Statutory Library</h2>
        <p style="font-size: 0.95rem; color: var(--text-muted); margin-top: 0.25rem;">Grounded in official Reserve Bank of India Master Directions and Central Acts of Parliament.</p>
      </div>
      <a href={`${basePath}articles/`} style="font-size: 0.9rem; font-weight: 600; color: var(--accent-emerald);">View All 15 Articles →</a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
      {articles.slice(0, 6).map((art) => (
        <a href={`${basePath}articles/${art.slug}/`} class="card-widget" style="text-decoration: none; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.2s ease;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-size: 0.75rem; color: var(--accent-emerald); font-weight: 600;">{art.data.readingTime}</span>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Verified: {art.data.verifiedOn}</span>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem; line-height: 1.4;">
              {art.data.title}
            </h3>
            <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1rem;">
              {art.data.description}
            </p>
          </div>

          <div style="border-top: 1px solid var(--border-subtle); padding-top: 0.75rem; margin-top: auto; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.75rem; color: var(--accent-cyan); font-weight: 600;">Read Full Analysis →</span>
            <span style="font-size: 0.7rem; color: var(--text-muted); font-family: var(--font-mono);">{art.data.statutoryReferences[0]}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Statutory Guarantees Banner -->
  <section style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 2rem; margin-bottom: 3rem;">
    <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.75rem;">
      The ZeroDebt India Statutory Guarantee
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6;">
      <div>
        <strong style="color: var(--accent-emerald); display: block; margin-bottom: 0.25rem;">1. Zero Remote Storage</strong>
        Your financial scenarios, balances, and grievance drafts exist exclusively in your browser session. We operate zero databases and zero tracking APIs.
      </div>
      <div>
        <strong style="color: var(--accent-cyan); display: block; margin-bottom: 0.25rem;">2. Primary Regulatory Citations</strong>
        Every legal claim cites exact RBI circular numbers, Gazette notifications, or legislative sections with active resolvable source links.
      </div>
      <div>
        <strong style="color: var(--accent-amber); display: block; margin-bottom: 0.25rem;">3. Strict Non-Commercial Independence</strong>
        We sell no loans, collect no affiliate referral fees, and promote no debt settlement agencies. Our research is 100% public education.
      </div>
    </div>
  </section>
</BaseLayout>
