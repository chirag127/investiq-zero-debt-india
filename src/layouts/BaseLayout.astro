---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  category?: string;
  verifiedOn?: string;
  lastUpdated?: string;
  statutoryReferences?: string[];
  tableOfContents?: { id: string; title: string }[];
  showSidebars?: boolean;
}

const {
  title,
  description,
  canonicalUrl = 'https://chirag127.github.io/investiq-zero-debt-india/',
  category,
  verifiedOn = '2026-10-17',
  lastUpdated = '2026-10-17',
  statutoryReferences = [],
  tableOfContents = [],
  showSidebars = true
} = Astro.props;

const currentPath = Astro.url.pathname;
const basePath = '/investiq-zero-debt-india/';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | InvestiQ ZeroDebt India</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | InvestiQ ZeroDebt India`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="InvestiQ ZeroDebt India" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | InvestiQ ZeroDebt India`} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon SVG -->
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
    <link rel="sitemap" href={`${basePath}sitemap-index.xml`} />

    <!-- Local Self-Contained KaTeX CSS (Zero-Tracker) -->
    <link rel="stylesheet" href={`${basePath}katex.min.css`} />
  </head>
  <body>
    <!-- Top Header -->
    <header class="site-header">
      <div class="header-inner">
        <a href={basePath} class="brand-wrapper">
          <span class="brand-badge">03 of 60</span>
          <span class="brand-title">
            ZeroDebt <span class="brand-network">| InvestiQ India</span>
          </span>
        </a>

        <nav aria-label="Main Navigation">
          <ul class="nav-links">
            <li><a href={basePath} class={`nav-link ${currentPath === basePath ? 'active' : ''}`}>Home</a></li>
            <li><a href={`${basePath}articles/`} class={`nav-link ${currentPath.includes('/articles') ? 'active' : ''}`}>Guides & Library</a></li>
            <li><a href={`${basePath}tools/`} class={`nav-link ${currentPath.includes('/tools') ? 'active' : ''}`}>Calculators & Tools</a></li>
            <li><a href={`${basePath}sources/`} class={`nav-link ${currentPath.includes('/sources') ? 'active' : ''}`}>Primary Sources</a></li>
            <li><a href={`${basePath}faq/`} class={`nav-link ${currentPath.includes('/faq') ? 'active' : ''}`}>Statutory FAQ</a></li>
            <li><a href={`${basePath}glossary/`} class={`nav-link ${currentPath.includes('/glossary') ? 'active' : ''}`}>Glossary</a></li>
          </ul>
        </nav>

        <div class="header-actions">
          <button id="search-open-btn" class="search-trigger-btn" aria-label="Open Search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span>Search</span>
          </button>
          <button id="theme-toggle-btn" class="theme-toggle-btn" aria-label="Toggle Dark/Light Mode">
            <span id="theme-icon">🌙</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Container: 3 Columns with Left & Right Sidebars -->
    <div class={`layout-container ${!showSidebars ? 'full-width' : tableOfContents.length === 0 ? 'two-column' : ''}`}>
      {showSidebars && (
        <aside class="left-sidebar" aria-label="Topic & Tools Navigation">
          <div class="sidebar-section">
            <h2 class="sidebar-title">Core Interactive Tools</h2>
            <ul class="sidebar-menu">
              <li><a href={`${basePath}tools/debt-payoff-calculator/`}>Multi-Loan Avalanche / Snowball</a></li>
              <li><a href={`${basePath}tools/credit-card-interest-calculator/`}>Credit Card APR & MAD Tool</a></li>
              <li><a href={`${basePath}tools/rbi-complaint-checker/`}>RBI Complaint Generator</a></li>
            </ul>
          </div>

          <div class="sidebar-section">
            <h2 class="sidebar-title">Research Categories</h2>
            <ul class="sidebar-menu">
              <li><a href={`${basePath}articles/#debt-triage`}>Debt Triage & Math</a></li>
              <li><a href={`${basePath}articles/#credit-cards`}>Credit Card APR & Charges</a></li>
              <li><a href={`${basePath}articles/#recovery-rights`}>RBI Recovery Agent Code</a></li>
              <li><a href={`${basePath}articles/#credit-repair`}>CIBIL & Dispute Rules</a></li>
              <li><a href={`${basePath}articles/#settlement-pitfalls`}>Settlement & Haircut Traps</a></li>
              <li><a href={`${basePath}articles/#legal-proceedings`}>SARFAESI, Sec 138 & PSSA</a></li>
            </ul>
          </div>

          <div class="sidebar-section">
            <h2 class="sidebar-title">Statutory Frameworks</h2>
            <ul class="sidebar-menu">
              <li><a href={`${basePath}articles/rbi-fair-practices-code-recovery-agents/`}>RBI Fair Practices Code</a></li>
              <li><a href={`${basePath}articles/cibil-credit-bureau-dispute-30-day-rule/`}>RBI/2023-24/72 (₹100/day)</a></li>
              <li><a href={`${basePath}articles/sarfaesi-act-borrower-rights-timeline/`}>SARFAESI Act 2002</a></li>
              <li><a href={`${basePath}articles/cheque-bounce-section-138-ni-act-and-enach/`}>Sec 138 NI & Sec 25 PSSA</a></li>
              <li><a href={`${basePath}articles/cash-loan-regulations-section-269ss-269t/`}>Sec 269SS/269T Cash Rules</a></li>
            </ul>
          </div>
        </aside>
      )}

      <!-- Main Central Content -->
      <main class="main-content">
        <slot />
      </main>

      {showSidebars && tableOfContents.length > 0 && (
        <aside class="right-sidebar" aria-label="Article Details & Table of Contents">
          <div class="card-widget">
            <div class="widget-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
              <span>On This Page</span>
            </div>
            <ul class="toc-list">
              {tableOfContents.map((item) => (
                <li><a href={`#${item.id}`}>{item.title}</a></li>
              ))}
            </ul>
          </div>

          <div class="card-widget">
            <div class="widget-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Statutory Rigor</span>
            </div>
            <div style="font-size: 0.825rem; color: var(--text-secondary); line-height: 1.5;">
              <p><strong>Verified On:</strong> {verifiedOn}</p>
              <p><strong>Last Updated:</strong> {lastUpdated}</p>
              {statutoryReferences.length > 0 && (
                <div style="margin-top: 0.5rem;">
                  <strong style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase;">Key Acts / Rules:</strong>
                  <ul style="padding-left: 1rem; margin-top: 0.25rem;">
                    {statutoryReferences.map((ref) => (
                      <li style="font-size: 0.775rem;">{ref}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>

          <div class="card-widget">
            <div class="widget-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
              <span>Borrower Notice</span>
            </div>
            <p style="font-size: 0.775rem; color: var(--text-muted); line-height: 1.45;">
              ZeroDebt India is an educational, non-commercial public research initiative. Calculations and legal outlines do not constitute formal legal counsel.
            </p>
          </div>
        </aside>
      )}
    </div>

    <!-- Search Modal -->
    <div id="search-modal" class="search-modal" role="dialog" aria-modal="true" aria-label="Site Search">
      <div class="search-box">
        <div class="search-input-wrapper">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="site-search-input" class="search-input" placeholder="Search debt recovery rules, CIBIL dispute, SARFAESI, tools..." autocomplete="off" />
          <button id="search-close-btn" class="btn btn-secondary btn-sm" aria-label="Close Search">Esc</button>
        </div>
        <div id="search-results-list" class="search-results">
          <!-- Dynamically populated -->
        </div>
      </div>
    </div>

    <!-- Site Footer -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href={basePath} class="brand-title">
            ZeroDebt <span class="brand-network">| InvestiQ India</span>
          </a>
          <p>
            ZeroDebt India provides mathematically rigorous debt triage simulators, primary statutory analysis of RBI lending directives, SARFAESI procedures, and step-by-step credit repair rights.
          </p>
          <div style="font-size: 0.8rem; color: var(--accent-emerald);">
            100% Client-Side • Zero Trackers • Zero Telemetry • No Data Storage
          </div>
        </div>

        <div>
          <h2 class="footer-col-title">Calculators & Tools</h2>
          <ul class="footer-links">
            <li><a href={`${basePath}tools/debt-payoff-calculator/`}>Multi-Loan Avalanche Simulator</a></li>
            <li><a href={`${basePath}tools/credit-card-interest-calculator/`}>Credit Card APR Calculator</a></li>
            <li><a href={`${basePath}tools/rbi-complaint-checker/`}>RBI Complaint Drafter</a></li>
            <li><a href={`${basePath}tools/`}>All Financial Tools</a></li>
          </ul>
        </div>

        <div>
          <h2 class="footer-col-title">Statutory Guides</h2>
          <ul class="footer-links">
            <li><a href={`${basePath}articles/rbi-fair-practices-code-recovery-agents/`}>Recovery Agent Calling Rules</a></li>
            <li><a href={`${basePath}articles/cibil-credit-bureau-dispute-30-day-rule/`}>₹100/Day CIBIL Compensation</a></li>
            <li><a href={`${basePath}articles/sarfaesi-act-borrower-rights-timeline/`}>SARFAESI Section 13 Guide</a></li>
            <li><a href={`${basePath}articles/cheque-bounce-section-138-ni-act-and-enach/`}>Sec 138 NI & Sec 25 PSSA</a></li>
            <li><a href={`${basePath}sources/`}>Primary Sources Index</a></li>
          </ul>
        </div>

        <div>
          <h2 class="footer-col-title">Editorial & Legal</h2>
          <ul class="footer-links">
            <li><a href={`${basePath}editorial-policy/`}>Editorial Policy</a></li>
            <li><a href={`${basePath}disclaimer/`}>Statutory Disclaimer</a></li>
            <li><a href={`${basePath}privacy/`}>Zero-Tracker Privacy Policy</a></li>
            <li><a href={`${basePath}corrections/`}>Report an Error / Corrections</a></li>
            <li><a href={`${basePath}faq/`}>Statutory FAQ</a></li>
            <li><a href="https://github.com/chirag127/investiq-zero-debt-india" target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <div>
          © 2026 InvestiQ India. Open-source educational financial initiative. Site 03 of 60.
        </div>
        <div>
          Built with Astro static output. Hosted on GitHub Pages with strict zero-tracking compliance.
        </div>
      </div>
    </footer>

    <!-- Client-Side Global Scripts: Theme, Search, Keyboard Navigation -->
    <script is:inline>
      // 1. Theme Toggle
      const themeBtn = document.getElementById('theme-toggle-btn');
      const themeIcon = document.getElementById('theme-icon');
      const currentTheme = localStorage.getItem('investiq_theme') || 'dark';

      document.documentElement.setAttribute('data-theme', currentTheme);
      if (themeIcon) {
        themeIcon.textContent = currentTheme === 'light' ? '☀️' : '🌙';
      }

      themeBtn?.addEventListener('click', () => {
        const nextTheme = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', nextTheme);
        localStorage.setItem('investiq_theme', nextTheme);
        if (themeIcon) {
          themeIcon.textContent = nextTheme === 'light' ? '☀️' : '🌙';
        }
      });

      // 2. Search Modal Toggle & Dynamic Filtering
      const searchModal = document.getElementById('search-modal');
      const searchOpenBtn = document.getElementById('search-open-btn');
      const searchCloseBtn = document.getElementById('search-close-btn');
      const searchInput = document.getElementById('site-search-input');
      const searchResultsList = document.getElementById('search-results-list');

      const SEARCH_INDEX = [
        { title: 'Multi-Loan Avalanche & Snowball Simulator', url: '/investiq-zero-debt-india/tools/debt-payoff-calculator/', category: 'Tool', snippet: 'Compare interest savings of avalanche vs snowball strategies across multiple Indian loans.' },
        { title: 'Credit Card Interest Cost & Payoff Calculator', url: '/investiq-zero-debt-india/tools/credit-card-interest-calculator/', category: 'Tool', snippet: 'Simulate revolving 42% APR, 18% GST compounding, and the true cost of paying Minimum Amount Due (MAD).' },
        { title: 'RBI Complaint Preparation & Statutory Delay Checker', url: '/investiq-zero-debt-india/tools/rbi-complaint-checker/', category: 'Tool', snippet: 'Diagnose recovery agent calling violations (8am-7pm) and calculate ₹100/day credit bureau delay compensation.' },
        { title: 'RBI Fair Practices Code & Recovery Agent Conduct', url: '/investiq-zero-debt-india/articles/rbi-fair-practices-code-recovery-agents/', category: 'Guide', snippet: 'Mandatory calling window 8 AM - 7 PM, harassment bans, privacy protections, and nodal grievance officer escalation.' },
        { title: 'CIBIL Credit Bureau 30-Day Dispute Rule & ₹100/Day Compensation', url: '/investiq-zero-debt-india/articles/cibil-credit-bureau-dispute-30-day-rule/', category: 'Guide', snippet: 'Comprehensive guide to circular RBI/2023-24/72, 21-day lender and 9-day CIC timeline, and claiming automatic compensation.' },
        { title: 'Credit Card APR, Revolving Debt & Negative Amortisation', url: '/investiq-zero-debt-india/articles/credit-card-apr-revolving-debt-trap/', category: 'Guide', snippet: 'How annualized 42-52% APR, unbilled cycle compounding, and 18% GST financial charges create perpetual debt.' },
        { title: 'Loan Settlement, Haircuts & The 7-Year CIBIL "Settled" Status', url: '/investiq-zero-debt-india/articles/loan-settlement-haircut-cibil-score-impact/', category: 'Guide', snippet: 'Understanding compromise settlements, OTS haircuts, DPD damage, and converting a Settled tag to Closed.' },
        { title: 'SARFAESI Act 2002: Secured Loan Defaults & Section 13 Timelines', url: '/investiq-zero-debt-india/articles/sarfaesi-act-borrower-rights-timeline/', category: 'Guide', snippet: 'Section 13(2) 60-day notice, Section 13(3A) 15-day representation, Section 13(4) possession, and Section 17 DRT appeals.' },
        { title: 'Cheque Bounce Under Section 138 NI Act vs eNACH Mandate Failures', url: '/investiq-zero-debt-india/articles/cheque-bounce-section-138-ni-act-and-enach/', category: 'Guide', snippet: 'Section 138 Negotiable Instruments Act 30-day notice timeline vs Section 25 Payment and Settlement Systems Act 2007.' },
        { title: 'Reserve Bank Integrated Ombudsman Scheme (RB-IOS 2021) Guide', url: '/investiq-zero-debt-india/articles/rbi-integrated-ombudsman-scheme-guide/', category: 'Guide', snippet: 'Filing complaints on RBI CMS portal, 30-day escalation requirement, up to ₹20L loss and ₹1L mental agony compensation.' },
        { title: 'Personal Loan Prepayment Charges & Balance Transfer Economics', url: '/investiq-zero-debt-india/articles/personal-loan-balance-transfer-prepayment-penalty/', category: 'Guide', snippet: 'RBI rules prohibiting foreclosure charges on floating-rate individual loans and balance transfer breakeven math.' },
        { title: 'Cash Loan Regulations: Income Tax Sections 269SS & 269T', url: '/investiq-zero-debt-india/articles/cash-loan-regulations-section-269ss-269t/', category: 'Guide', snippet: 'Statutory ₹20,000 cash loan acceptance and repayment ceiling, 100% penalties under 271D/271E, and Section 269ST.' }
      ];

      function openSearch() {
        if (!searchModal) return;
        searchModal.classList.add('active');
        searchInput?.focus();
        renderSearchResults('');
      }

      function closeSearch() {
        if (!searchModal) return;
        searchModal.classList.remove('active');
        if (searchInput) searchInput.value = '';
      }

      function renderSearchResults(query) {
        if (!searchResultsList) return;
        const q = query.toLowerCase().trim();
        const filtered = q === '' 
          ? SEARCH_INDEX.slice(0, 5) 
          : SEARCH_INDEX.filter(item => 
              item.title.toLowerCase().includes(q) || 
              item.snippet.toLowerCase().includes(q) ||
              item.category.toLowerCase().includes(q)
            );

        if (filtered.length === 0) {
          searchResultsList.innerHTML = `<div style="padding: 1.5rem; text-align: center; color: var(--text-muted); font-size: 0.9rem;">No matching guides or tools found for "${query}".</div>`;
          return;
        }

        searchResultsList.innerHTML = filtered.map(item => `
          <a href="${item.url}" class="search-result-item">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
              <span class="search-result-title">${item.title}</span>
              <span style="font-size: 0.7rem; background: var(--bg-tertiary); padding: 0.15rem 0.4rem; border-radius: 4px; color: var(--accent-cyan); font-weight: 600;">${item.category}</span>
            </div>
            <div class="search-result-snippet">${item.snippet}</div>
          </a>
        `).join('');
      }

      searchOpenBtn?.addEventListener('click', openSearch);
      searchCloseBtn?.addEventListener('click', closeSearch);

      searchModal?.addEventListener('click', (e) => {
        if (e.target === searchModal) closeSearch();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
          e.preventDefault();
          openSearch();
        }
        if (e.key === 'Escape' && searchModal?.classList.contains('active')) {
          closeSearch();
        }
      });

      searchInput?.addEventListener('input', (e) => {
        renderSearchResults(e.target.value);
      });
    </script>

    <!-- Local KaTeX Auto-Renderer (Zero-Tracker) -->
    <script is:inline src={`${basePath}katex.min.js`}></script>
    <script is:inline src={`${basePath}auto-render.min.js`}></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        if (window.renderMathInElement) {
          window.renderMathInElement(document.body, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '$', right: '$', display: false },
              { left: '\\(', right: '\\)', display: false },
              { left: '\\[', right: '\\]', display: true }
            ],
            throwOnError: false
          });
        }
      });
    </script>

    <!-- Local Mermaid JS Renderer (Zero-Tracker) -->
    <script is:inline src={`${basePath}mermaid.min.js`}></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        if (window.mermaid) {
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
          window.mermaid.initialize({
            startOnLoad: false,
            theme: currentTheme === 'dark' ? 'dark' : 'default',
            securityLevel: 'loose',
            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif'
          });

          // Convert code.language-mermaid or pre.mermaid to renderable containers
          const codeBlocks = document.querySelectorAll('pre code.language-mermaid, pre.mermaid');
          codeBlocks.forEach(async (el, idx) => {
            const rawGraph = el.textContent || '';
            const parent = el.closest('pre') || el;
            const container = document.createElement('div');
            container.className = 'mermaid-container';
            container.style.overflowX = 'auto';
            container.style.margin = '2rem 0';
            container.style.padding = '1.25rem';
            container.style.background = 'var(--bg-card)';
            container.style.border = '1px solid var(--border-subtle)';
            container.style.borderRadius = 'var(--radius-md)';
            container.style.textAlign = 'center';

            try {
              const { svg } = await window.mermaid.render(`mermaid-svg-${idx}`, rawGraph.trim());
              container.innerHTML = svg;
              parent.replaceWith(container);
            } catch (err) {
              console.warn('Mermaid rendering notice:', err);
            }
          });
        }
      });
    </script>
  </body>
</html>
